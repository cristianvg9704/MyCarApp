# Copia este archivo a `.env` y rellena los valores. `.env` no se versiona.
# Se carga al ejecutar/compilar con:  flutter run --dart-define-from-file=.env

# Supabase → Project Settings → API (URL y clave "anon"/public, nunca la service_role)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=

# RevenueCat → Project settings → API keys (claves públicas del SDK)
REVENUECAT_IOS_API_KEY=appl_
REVENUECAT_ANDROID_API_KEY=goog_

# Google Cloud → Credentials (ver docs/SOCIAL_AUTH_SETUP.md)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
